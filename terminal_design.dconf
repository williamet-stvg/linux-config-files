# gnome-terminal profile settings — NATIVE Ubuntu only.
#
# This file is NOT used under WSL. See windows-terminal/settings-fragment.jsonc.
#
# init.sh loads this into whichever profile is actually the default, resolved
# at runtime with:
#     gsettings get org.gnome.Terminal.ProfilesList default
#
# The original script hardcoded the path
#     /org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9/
# That UUID is specific to one machine's profile. On a fresh install the
# default profile has a different UUID, so the load wrote settings into a
# profile that was not registered in the profile list — meaning nothing
# visible changed, with no error.
#
# Manual load (native only):
#     PROFILE=$(gsettings get org.gnome.Terminal.ProfilesList default | tr -d \"\')
#     dconf load "/org/gnome/terminal/legacy/profiles:/:$PROFILE/" < terminal_design.dconf
 
[/]
visible-name='wk_terminal'
use-theme-colors=false
background-color='rgb(24,39,43)'
foreground-color='rgb(255,255,255)'
bold-color-same-as-fg=true
cursor-colors-set=false
default-size-columns=120
default-size-rows=32
scrollback-lines=50000
scrollback-unlimited=false
login-shell=false
audible-bell=false
scrollbar-policy='always'
cursor-blink-mode='on'
cursor-shape='block'
 
